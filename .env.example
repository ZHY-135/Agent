# RAG 项目环境变量样例
#
# 用法：
#   cp .env.example .env      # 然后填入真实值
#   ⚠ .env 已在 .gitignore 中排除，切勿把真实密钥提交到仓库
#
# 说明：核心功能（demo / qa / eval）**零依赖、零配置**即可运行，
#       本文件里的变量只在启用真实 embedding 或 pgvector 持久化时才需要。

# ---------- 向量存储后端 ----------
# memory   : 进程内存储，仅用于演示与测试（索引不跨进程）
# pgvector : PostgreSQL + pgvector，生产模式
RAG_BACKEND=memory

# ---------- 嵌入实现 ----------
# hash   : 零依赖伪向量，离线跑通链路用；**只认字面重合**，分数不具语义意义
# local  : 本机真实语义向量（fastembed/ONNX，**无需 API Key**）
#          ⚠ 首次使用会联网下载模型权重；需先装：pip install "rag-min[local]"
# openai : 真实语义向量（需 OPENAI_API_KEY）
RAG_EMBEDDING_PROVIDER=hash

# 嵌入模型名（仅 openai 时生效）
RAG_EMBED_MODEL=text-embedding-3-small

# 本机模型名（仅 local 时生效）。默认 BAAI/bge-small-zh-v1.5（512 维，中文小模型）
# 可选项见 RAG/config.py 的 LOCAL_EMBED_MODELS
# RAG_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# 本机模型权重缓存目录（仅 local 时生效）。留空 = 用 fastembed 默认位置（用户目录）。
# ⚠ 受限/沙箱环境**必须**指向工作区内，否则下载会因无写权限而失败：
# RAG_LOCAL_CACHE_DIR=./.models

# 向量维度：**必须与数据库 vector(n) 列一致**，换模型时必须同步修改。
# local 模式下留空会自动按模型取（见 settings.resolve_embedding_dim）；
# 若用了 LOCAL_EMBED_MODELS 里没有的模型，则**必须**显式设置这里，否则会明确报错。
# RAG_EMBED_DIM=1536

# ---------- 密钥与连接串 ----------
# 仅 RAG_EMBEDDING_PROVIDER=openai 时需要
OPENAI_API_KEY=

# 仅 RAG_BACKEND=pgvector 时需要
# DATABASE_URL=postgresql://user:password@localhost:5432/rag

# ---------- 测试/压测的临时目录（可选）----------
# 受限沙箱环境下系统 temp 可能不可写，可指向一个已存在的可写目录
# RAG_TEST_TMPDIR=./tmp
