# RAG 项目环境变量样例
#
# 用法：
#   cp .env.example .env      # 然后填入真实值
#   ⚠ .env 已在 .gitignore 中排除，切勿把真实密钥提交到仓库
#
# 说明：核心功能（demo / qa / eval）**零依赖、零配置**即可运行，
#       本文件里的变量只在启用真实 embedding 或 pgvector 持久化时才需要。

# ---------- 向量存储后端 ----------
# memory   : 进程内存储，仅用于演示与测试（索引不跨进程）
# pgvector : PostgreSQL + pgvector，生产模式
RAG_BACKEND=memory

# ---------- 嵌入实现 ----------
# hash   : 零依赖伪向量，离线跑通链路用；分数不具语义意义
# openai : 真实语义向量（需 OPENAI_API_KEY）
RAG_EMBEDDING_PROVIDER=hash

# 嵌入模型名（仅 openai 时生效）
RAG_EMBED_MODEL=text-embedding-3-small

# 向量维度：**必须与数据库 vector(n) 列一致**，换模型时必须同步修改
RAG_EMBED_DIM=1536

# ---------- 密钥与连接串 ----------
# 仅 RAG_EMBEDDING_PROVIDER=openai 时需要
OPENAI_API_KEY=

# 仅 RAG_BACKEND=pgvector 时需要
# DATABASE_URL=postgresql://user:password@localhost:5432/rag

# ---------- 测试/压测的临时目录（可选）----------
# 受限沙箱环境下系统 temp 可能不可写，可指向一个已存在的可写目录
# RAG_TEST_TMPDIR=./tmp
